<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>Neatlify Desktop</string>
    <key>CFBundleIdentifier</key>
    <string>com.neatlify.Desktop</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>Neatlify Desktop</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>15.2</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2025 Neatlify. All rights reserved.</string>
    <key>NSDesktopFolderUsageDescription</key>
    <string>Neatlify needs access to your Desktop folder to organize your files.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>Neatlify needs access to your Documents folder to organize your files.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>Neatlify needs access to your Downloads folder to organize your files.</string>

    <!-- Network Client -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>
        <key>NSExceptionDomains</key>
        <dict>
            <key>anthropic.com</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
                <false/>
                <key>NSTemporaryExceptionMinimumTLSVersion</key>
                <string>TLSv1.2</string>
            </dict>
            <key>stripe.com</key>
            <dict>
                <key>NSIncludesSubdomains</key>
                <true/>
                <key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
                <false/>
                <key>NSTemporaryExceptionMinimumTLSVersion</key>
                <string>TLSv1.2</string>
            </dict>
        </dict>
    </dict>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>com.neatlify.desktop</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>neatlify</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
